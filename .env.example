# Django Settings
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-secure-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,172.30.5.24

# Database Configuration (PostGIS)
DJANGO_DB_NAME=zingsa_collect
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=postgres
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=8200

# Redis & Channels Configuration
REDIS_URL=redis://127.0.0.1:8201/0

# Celery Configuration
CELERY_BROKER_URL=redis://127.0.0.1:8201/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:8201/2

# Time Zone Configuration
TIME_ZONE=Africa/Harare

# MinIO credentials (match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in docker-compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Storage settings (S3 / MinIO)
# docker-compose overrides AWS_S3_ENDPOINT_URL to http://minio:9000 internally
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=zingsa-collect-media
AWS_S3_ENDPOINT_URL=http://172.30.5.24:9018
AWS_S3_CUSTOM_DOMAIN=172.30.5.24:9018/zingsa-collect-media
USE_S3=True

# Maintenance mode (owner kill switch). 0 = off. 1 = HTTP 503 for everyone else.
# Bypass while it is on:
#   POST /__owner/maintenance-bypass/ with form field token
#   or send header X-Maintenance-Owner-Token
# GET works for the same field. Clear the cookie at /__owner/maintenance-bypass/clear/
# MAINTENANCE_OWNER_TOKEN belongs in the Kubernetes Secret (zingsa-env), not the ConfigMap.
# On the cluster, toggle MAINTENANCE_MODE with scripts/k8s-ops.sh (no image rebuild).
MAINTENANCE_MODE=0
MAINTENANCE_OWNER_TOKEN=replace-with-a-long-random-token
# Optional overrides:
# MAINTENANCE_MESSAGE=ZINGSA Collect is temporarily unavailable while maintenance is in progress.
# MAINTENANCE_RETRY_AFTER=300
# MAINTENANCE_BYPASS_COOKIE_NAME=zingsa_collect_maintenance_bypass
# MAINTENANCE_BYPASS_COOKIE_MAX_AGE=604800
